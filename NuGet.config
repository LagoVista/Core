      <package pattern="LagoVista.Core.Rpc.Client" />
      <package pattern="LagoVista.Core.Rpc.Server" />
      <package pattern="LagoVista.Core.TestBase" />
      <package pattern="LagoVista.Crypto" />
      <package pattern="LagoVista.IoT.Logging" />
      <package pattern="LagoVista.IoT.Logging.Rest" />
      <package pattern="LagoVista.IoT.Web.Common" />
