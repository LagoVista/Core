      <package pattern="LagoVista.JobManager.Repos" />
      <package pattern="LagoVista.JobManager.Rest" />
      <package pattern="LagoVista.LogZIO" />
      <package pattern="LagoVista.MessageQueue.Rabbit" />
      <package pattern="LagoVista.Net.LetsEncrypt" />
      <package pattern="LagoVista.PDFServices" />
      <package pattern="LagoVista.Relational" />
      <package pattern="LagoVista.Relational.Tests.Core" />
      <package pattern="LagoVista.UserAdmin" />
      <package pattern="LagoVista.UserAdmin.Models" />
      <package pattern="LagoVista.UserAdmin.Repos" />
      <package pattern="UserAdmin.RepoTest" />
    </packageSource>
    <packageSource key="nuviot-local">
      <package pattern="LagoVista.AspNetCore.AuthorizationServer" />
      <package pattern="LagoVista.AspNetCore.Identity" />
      <package pattern="LagoVista.CloudStorage" />
      <package pattern="LagoVista.Core" />
