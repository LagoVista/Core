      <package pattern="LagoVista.IoT.Logging" />
      <package pattern="LagoVista.IoT.Logging.Rest" />
      <package pattern="LagoVista.IoT.Web.Common" />
      <package pattern="LagoVista.JobManager" />
      <package pattern="LagoVista.JobManager.Models" />
      <package pattern="LagoVista.JobManager.Repos" />
      <package pattern="LagoVista.JobManager.Rest" />
      <package pattern="LagoVista.LogZIO" />
